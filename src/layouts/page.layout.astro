---
import "../styles/global.css";
import { version } from "../../package.json";
---

<!doctype html>
<html lang="en" class="h-full scheme-light-dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta
			name="description"
			content="Julius Möhring — Building AI applications and agents that people want to use, make work easier, and create business value. Based in Hamburg."
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="version" content={version} />
		<title>Julius Möhring - AI &amp; Software Engineering</title>
	</head>
	<body
		class="bg-background text-ink selection:bg-accent selection:text-background m-0 h-full font-sans leading-normal antialiased transition-colors duration-300 ease-in-out **:transition-colors **:duration-300 **:ease-in-out motion-reduce:transition-none motion-reduce:**:transition-none"
	>
		<div
			class="relative isolate mx-auto grid min-h-dvh max-w-450 grid-rows-[auto_1fr_auto] px-6 py-4 max-[360px]:px-5 sm:px-8 sm:py-5 lg:px-12 lg:py-6 2xl:px-14"
		>
			<div
				class="pointer-events-none absolute inset-0 -z-10 mx-auto max-w-7xl bg-[linear-gradient(var(--color-grid)_1px,transparent_1px),linear-gradient(90deg,var(--color-grid)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_center,#000_10%,transparent_68%)] bg-size-[32px_32px]"
				aria-hidden="true"
			></div>

			<slot />
		</div>
	</body>
</html>
