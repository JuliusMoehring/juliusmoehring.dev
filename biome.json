{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!**/.astro", "!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noUnknownAtRules": "on"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "error",
					"fix": "safe"
				},
				"useTailwindStaticClassStrings": {
					"level": "error"
				},
				"useTailwindShorthandClasses": {
					"level": "error",
					"fix": "safe"
				}
			},
			"a11y": {
				"useSemanticElements": "off"
			}
		},
		"domains": {
			"astro": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"quoteStyle": "double",
			"attributePosition": "auto",
			"bracketSpacing": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"selfCloseVoidElements": "always"
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	}
}
